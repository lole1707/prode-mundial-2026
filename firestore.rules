rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Matches: solo el admin puede escribir, todos los usuarios autenticados pueden leer
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "REEMPLAZAR_CON_ADMIN_UID";
    }

    // Predictions: solo el propio usuario puede leer/escribir sus pronósticos
    match /predictions/{predId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // El admin puede leer todas las predicciones (para recalcular puntajes)
      allow read: if request.auth != null && request.auth.uid == "REEMPLAZAR_CON_ADMIN_UID";
    }

    // Users: cualquier autenticado puede leer (para el leaderboard), solo el propio usuario o admin puede escribir
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == "REEMPLAZAR_CON_ADMIN_UID");
    }
  }
}
